import random
tar=random.randrange(1,1000000000000)
left,right=1,1000000000000
count=0
while 1:
    middle=(left+right)//2
    count+=1
    if middle<tar:
        left=middle+1
    if middle>tar:
        right=middle-1
    if middle==tar:
        print(middle)
        print(f"一共猜了{count}次")
        break
